body 
{
  margin: 0;
  font-family: arial, sans-serif;
  background: #ffffff;
  color: black;
}

header 
{
  background: #132A42;
  color: white;
  display: flex;
  justify-content: space-between;
  padding: 10px;
  align-items: center;
  position: relative;
}

header h1 
{
  font-size: 20px;
  margin: 0;
}

nav 
{
  display: flex;
  gap: 10px;
  align-items: center;
}

nav a 
{
  color: white;
  text-decoration: none;
  padding: 6px 10px;
  border-radius: 6px;
}

nav a:hover 
{
  text-decoration: underline;
}

main 
{
  padding: 16px;
}



.cards 
{
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-top: 16px;
}

table 
{
  width: 100%;
  border-collapse: collapse;
  margin-top: 16px;
}

th, td 
{
  border: 1px solid #ffffff;
  padding: 8px;
}

th 
{
  background: #ffffff;
  text-align: left;
}

form 
{
  max-width: 650px;
}

label 
{
  display: block;
  margin-top: 10px;
}

input, select, textarea 
{
  width: 100%;
  padding: 8px;
  margin-top: 6px;
  box-sizing: border-box;
}

.inline 
{
  display: flex;
  gap: 10px;
  align-items: center;
}

.inline input 
{
  width: auto;
}

.error 
{
  color: red;
  font-size: 14px;
  margin-top: 6px;
}

.nav-toggle 
{
  display: none;
  background: transparent;
  color: white;
  border: 1px solid rgb(255, 255, 255);
  padding: 6px 10px;
  border-radius: 6px;
}





@media (max-width: 700px) 
{

  .cards 
  {
    grid-template-columns: 1fr;
  }

  .nav-toggle 
  {
    display: inline-block;
  }

  nav 
  {
    display: none;
    flex-direction: column;
    align-items: flex-start;
    background: #132A42;
    padding: 10px;
    position: absolute;
    top: 52px;
    right: 10px;
    border-radius: 10px;
  }

  nav.open 
  {
    display: flex;
  }
}
